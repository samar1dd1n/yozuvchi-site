server {
    listen 80;
    server_name sayt.uz www.sayt.uz;

    # Sahifa fayllari (PDF) 50 MB gacha, ko'p faylni birdan yuklash uchun zaxira bilan
    client_max_body_size 300M;

    location /static/ {
        alias /var/www/yozuvchi/staticfiles/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /var/www/yozuvchi/media/;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
